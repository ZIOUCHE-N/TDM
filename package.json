{
  "name": "tdm",
  "version": "0.1.0",
  "description": "TDM — Téléchargement Download Manager",
  "private": true,
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:win": "electron-vite build && electron-builder --win",
    "test:bridge": "node scripts/bridge-test.mjs",
    "test:packaged": "node scripts/packaged-smoke.mjs dist/linux-unpacked/tdm",
    "test:extension": "node scripts/extension-test.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.22",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "undici": "8.12.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react-swc": "4.3.3",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "jsdom": "^27.0.0",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "author": "TDM contributors",
  "desktopName": "tdm.desktop",
  "homepage": "https://tdm.example"
}
